# .env.example
# ============================================================
# PRODUCTION (Vercel + Supabase cloud)
# ============================================================

# Stage 1 vars (unchanged)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
GALLERY_WRITER_IDS=comma,separated,supabase,user,ids

# Stage 2 additions
PRINTIFY_API_KEY=your-printify-api-key
PRINTIFY_SHOP_ID=your-printify-shop-id

# Cron auth. IMPORTANT: Vercel cron jobs send an HTTP GET request and, when
# this env var is set, automatically include it as `Authorization: Bearer
# $CRON_SECRET`. The batch route accepts that form plus an x-cron-secret
# header for manual curl triggers.
CRON_SECRET=a-long-random-secret-for-cron-auth

# Browser-exposed (safe — anon key only, never service role)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================================
# LOCAL DEV against the bundled Supabase shim (no cloud needed)
# Run `npm run shim -- --seed-demo`, then set:
# ============================================================

# Server-side (the engine talks to the shim directly)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=local-shim
SUPABASE_ANON_KEY=local-shim
GALLERY_WRITER_IDS=demo-user
CRON_SECRET=demo-cron-secret

# Browser-side (relative — the app origin proxies /supabase/* to the shim)
NEXT_PUBLIC_SUPABASE_URL=/supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-shim
# Rewrites server-stored media URLs so <img> tags load via the app origin
NEXT_PUBLIC_MEDIA_HOST_REWRITE=http://127.0.0.1:54321

# Build-time only: bakes the /supabase/* rewrites into the Next server
LOCAL_SUPABASE_SHIM_URL=http://127.0.0.1:54321
